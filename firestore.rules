rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function isMember(fid) { return signedIn() && request.auth.uid in get(famPath(fid)).data.members; }

    // Profilo personale: lo legge e lo scrive solo il proprietario.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Codici invito: si può leggere un codice solo conoscendolo (nessun elenco).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fid'])
        && request.resource.data.fid is string
        && isMember(request.resource.data.fid);
      allow update: if false;
      allow delete: if signedIn() && isMember(resource.data.fid);
    }

    // Famiglie: le vedono solo i membri.
    match /families/{fid} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'members', 'code'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      allow update: if signedIn() && (
        // Entrare: ci si può aggiungere solo da soli (l'id si ottiene col codice invito).
        ( !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 10
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members )
        ||
        // Già membro: cambiare nome o codice, oppure uscire.
        ( request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code', 'members'])
          && request.resource.data.members.hasOnly(resource.data.members)
          && request.resource.data.members.size() <= resource.data.members.size() )
      );

      // Si elimina la famiglia solo se sei l'ultimo membro.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.members.size() == 1;

      // Piano, spesa, preferiti, ecc.: solo i membri.
      match /state/{docId} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
