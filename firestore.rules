rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function invPath(code) { return /databases/$(database)/documents/invites/$(code); }
    function isMember(fid) { return signedIn() && request.auth.uid in get(famPath(fid)).data.members; }

    // Profilo personale: lo legge e lo scrive solo il proprietario.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Codici invito: si può leggere un codice solo conoscendolo (nessun elenco).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fid'])
        && request.resource.data.fid is string
        && isMember(request.resource.data.fid);
      allow update: if false;
      allow delete: if signedIn() && isMember(resource.data.fid);
    }

    // Famiglie: le vedono solo i membri.
    match /families/{fid} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'members', 'code'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      allow update: if signedIn() && (
        // Entrare: solo con un invito valido. Chi entra scrive in join {uid, code} sé stesso e il codice usato:
        // il codice deve essere quello attuale della famiglia e invites/{codice} deve puntare a questa famiglia.
        // Così chi conosce solo l'id interno (es. un ex membro) non entra, e dopo il rinnovo il vecchio codice non vale.
        ( !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'join'])
          && request.resource.data.join is map
          && request.resource.data.join.keys().hasOnly(['uid', 'code'])
          && request.resource.data.join.uid == request.auth.uid
          && request.resource.data.join.code is string
          && request.resource.data.join.code == resource.data.code
          && exists(invPath(request.resource.data.join.code))
          && get(invPath(request.resource.data.join.code)).data.fid == fid
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 10
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members )
        ||
        // Già membro: cambiare nome o codice (i membri restano gli stessi).
        ( request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.code is string )
        ||
        // Uscire: ognuno può togliere solo sé stesso (mai gli altri). L'ultimo membro elimina la famiglia.
        ( request.auth.uid in resource.data.members
          && resource.data.members.size() > 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]) )
      );

      // Si elimina la famiglia solo se sei l'ultimo membro.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.members.size() == 1;

      // Piano, spesa, preferiti, ecc.: i membri leggono e scrivono;
      // cancellare i documenti condivisi può solo l'ultimo membro (quando chiude la famiglia).
      match /state/{docId} {
        allow read, create, update: if isMember(fid);
        allow delete: if isMember(fid) && get(famPath(fid)).data.members.size() == 1;
      }
    }

    // Formichina: un documento per famiglia, con nome derivato dalla frase segreta (40 caratteri).
    // Il contenuto è cifrato sul telefono: Firebase vede solo un blocco illeggibile.
    match /budgets/{docId} {
      allow get, delete: if request.auth != null && docId.size() == 40;
      allow list: if false; // nessuno può elencare i documenti degli altri
      allow create, update: if request.auth != null
        && docId.size() == 40
        && request.resource.data.keys().hasOnly(['data', 'by', 'v', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1048000;
    }
  }
}
